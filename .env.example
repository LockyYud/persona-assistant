# --- Database ---
# Standard Postgres connection string. Works with Supabase (session pooler
# port 5432 for full session/transaction support), Neon, Render Postgres, or
# any Postgres host.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# --- Auth (apps/web) ---
AUTH_SECRET=replace-with-32-byte-random-string
NEXTAUTH_URL=http://localhost:3000

# --- Worker (apps/worker) ---
PORT=8787
WORKER_INTERNAL_HMAC_SECRET=replace-with-random-secret
WORKER_BFF_SHARED_SECRET=replace-with-random-secret
# Single-user password login (no OAuth). Generate a strong random password,
# store only its bcrypt hash here (worker verifies it and rate-limits
# attempts); the plaintext password itself is never stored anywhere.
# node -e "require('bcryptjs').hash('<password>', 12).then(console.log)"
AUTH_PASSWORD_HASH=replace-with-bcrypt-hash
AUTH_ALLOWED_EMAIL=duy.dm@teko.vn

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ONBOARDING_TOKEN=replace-with-random-token
# Verifies incoming POST /telegram/webhook calls actually came from Telegram
# (sent back as X-Telegram-Bot-Api-Secret-Token). Required to use Telegram as
# an interactive chat channel, not just outbound reminders.
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret

# --- Notion (optional) ---
# When set, the agent gains notion_search/notion_get_page tools to look up
# pages in the user's Notion workspace as read-only context. Unset entirely
# to disable the integration.
NOTION_API_KEY=

# When also set, tasks are two-way synced with this Notion database: the
# scheduler tick pulls in edits made on the Notion side, and every
# create/update/complete pushes the task's new state back to its page.
# Postgres stays the transactional source for reminders/scheduling — Notion
# is a mirror, not a replacement — see apps/worker/src/services/notion-sync.ts.
# The database must have these properties, named exactly:
#   - a title property (any name) for the task title
#   - Status   (select: open, in_progress, done, cancelled)
#   - Priority (select: low, medium, high, urgent)
#   - Type     (select: work, personal, chore)
#   - Due      (date)
#   - Description (text, optional)
#   - Parent   (relation to this same database) — links a step to its task
#   - Progress (number, percent format) — written by the app, do not edit by
#     hand; it's the share of finished steps and is overwritten every sync
# Share the database with your Notion integration before setting this.
NOTION_TASKS_DATABASE_ID=

# --- Web search (optional, via Tavily) ---
# When set, the agent gains a web_search tool for current-events / internet
# lookups. Unset entirely to disable.
TAVILY_API_KEY=

# --- LLM provider (any OpenAI-compatible chat completions API) ---
# OpenAI:      LLM_BASE_URL unset, LLM_MODEL=gpt-4o-mini
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com, LLM_MODEL=deepseek-chat
# Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, LLM_MODEL=gemini-1.5-pro
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_MODEL=<provider/model>
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional: model used only for breaking a task into steps
# (proposeTaskBreakdown). That's a harder reasoning job than a normal chat
# turn — a cheap model tends to return generic filler steps ("research",
# "implement", "test") — so it can run on a stronger tier than LLM_MODEL
# without paying for that tier on every message. Defaults to LLM_MODEL.
LLM_BREAKDOWN_MODEL=

# --- Web -> Worker ---
WORKER_BASE_URL=http://localhost:8787
