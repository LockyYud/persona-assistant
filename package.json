{
  "name": "persona-assistant",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "dev:web": "pnpm --filter @persona/web dev",
    "dev:worker": "pnpm --filter @persona/worker dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "db:generate": "pnpm --filter @persona/db generate",
    "db:migrate": "pnpm --filter @persona/db migrate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0"
}
